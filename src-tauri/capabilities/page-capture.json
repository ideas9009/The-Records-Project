{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "page-capture",
  "description": "Copy screenshots and export EarthMC PDFs to Downloads.",
  "windows": [
    "main"
  ],
  "permissions": [
    "clipboard-manager:allow-write-image",
    "dialog:allow-save",
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        {
          "path": "$DOWNLOAD/TRP-EarthMC-players-*.pdf"
        },
        {
          "path": "$DOWNLOAD/TRP-EarthMC-town-*.pdf"
        },
        {
          "path": "$DOWNLOAD/TRP-EarthMC-player-*.pdf"
        }
      ]
    }
  ]
}
